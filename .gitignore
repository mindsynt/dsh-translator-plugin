# Dependencies
node_modules/

# Model binaries assembled from split parts (model-part-aa, model-part-ab)
# These are generated on first load; the parts are committed instead because
# GitHub rejects files over 100 MB.
models/**/model.bin

# Package manager caches & install state
.pnpm-store/
package-lock.json
yarn.lock
npm-shrinkwrap.json

# Node error dumps
npm-debug.log*
yarn-error.log*

# OS & editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# CTranslate2 native addon (modified for NLLB support)
!node_modules/ctranslate2/
!node_modules/ctranslate2/**

# Rust build artifacts (do not commit)
node_modules/ctranslate2/target/
node_modules/ctranslate2/*.node
!node_modules/ctranslate2/index.linux-x64-gnu.node
!node_modules/ctranslate2/ct2.*.node
